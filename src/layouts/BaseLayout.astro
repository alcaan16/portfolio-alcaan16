---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ángel Alférez Castro',
  alternateName: 'alcaan16',
  jobTitle: 'SAP ABAP Developer',
  email: 'mailto:angelalferezcastro@gmail.com',
  url: 'https://alcaan16.es',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'La Carlota',
    addressRegion: 'Córdoba',
    addressCountry: 'ES',
  },
  sameAs: ['https://github.com/alcaan16', 'https://www.linkedin.com/in/alcaan-dev'],
  knowsAbout: [
    'ABAP Cloud',
    'RAP',
    'SAP BTP',
    'SAP Cloud Application Programming Model',
    'SAP Integration Suite',
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Portfolio de Ángel Alférez Castro — SAP ABAP Developer, con el ticket de báscula de la validación de peso medio por pieza"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b1215" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <slot />
    <script>
      // Reveals al hacer scroll — mejora progresiva: sin JS o con reduced-motion todo queda visible.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window) {
        const selector = [
          '.section-head',
          '.bloque',
          '.metricas',
          '.bloques-2col > div',
          '.stack-grid > div',
          '.capturas-grid .captura',
          '.certs-grid .cert',
          '.otros-grid .otro',
          '.timeline > li',
          '.limites',
        ].join(', ');
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        document.querySelectorAll(selector).forEach((el) => {
          const siblings = el.parentElement ? Array.from(el.parentElement.children) : [];
          const delay = (siblings.indexOf(el) % 6) * 70;
          (el as HTMLElement).style.transitionDelay = `${delay}ms`;
          el.classList.add('reveal');
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>
