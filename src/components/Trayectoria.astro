---
import { hitos } from '../data/trayectoria';
---

<section id="trayectoria" class="section section--paper-deep">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">Trayectoria</p>
      <h2>De la planta al código</h2>
    </header>

    <ol class="timeline">
      {
        hitos.map((hito) => (
          <li>
            <p class="timeline__periodo">{hito.periodo}</p>
            <h3>{hito.titulo}</h3>
            {hito.subtitulo && <p class="timeline__subtitulo">{hito.subtitulo}</p>}
            {hito.cifras && (
              <ul class="metricas timeline__cifras">
                {hito.cifras.map((cifra) => (
                  <li class="metrica">
                    <span class="metrica__valor">{cifra.valor}</span>
                    <span class="metrica__label">{cifra.label}</span>
                  </li>
                ))}
              </ul>
            )}
            {hito.parrafos.map((parrafo) => (
              <p class="timeline__parrafo">{parrafo}</p>
            ))}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--rule);
    display: grid;
    gap: 2.8rem;
  }

  .timeline li {
    position: relative;
    padding-left: 1.9rem;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: -4.5px;
    top: 0.45rem;
    width: 8px;
    height: 8px;
    background: var(--accent);
  }

  .timeline__periodo {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--accent-deep);
  }

  .timeline h3 {
    margin-top: 0.35rem;
  }

  .timeline__subtitulo {
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }

  .timeline__cifras {
    margin-top: 1.1rem;
  }

  .timeline__parrafo {
    margin-top: 0.9rem;
    font-size: 0.96rem;
    max-width: 72ch;
  }
</style>
